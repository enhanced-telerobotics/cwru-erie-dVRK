{
  "type": "dvrk_data:stereo_alignment@1.0.0",
  "name": "dvrk_display_sdi",
  "camera": {
    "size": {
      "width": 1920,
      "height": 1080
    },
    "left": {
      "gst_input": "unixfdsrc socket-path=dvrk:stereo_source:left socket-type=abstract do-timestamp=true ! video/x-raw,format=I420,width=1920,height=1080",
      "color": {
        "brightness": 0.0,
        "contrast": 1.0,
        "saturation": 1.0,
        "hue": 0.0
      }
    },
    "right": {
      "gst_input": "unixfdsrc socket-path=dvrk:stereo_source:right socket-type=abstract do-timestamp=true ! video/x-raw,format=I420,width=1920,height=1080",
      "color": {
        "brightness": 0.0,
        "contrast": 1.0,
        "saturation": 1.0,
        "hue": 0.0
      }
    },
    "alignment": {
      "horizontal_shift_px": 22,
      "vertical_shift_px": -24
    },
    "crop": {
      "width": 1840,
      "height": 1038
    }
  },
  "preserve_size": true,
  "gst_output": "@dvrk:stereo_alignment:stereo"
}
